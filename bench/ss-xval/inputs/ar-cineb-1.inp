&GLOBAL
  PRINT_LEVEL LOW
  PROJECT band
  RUN_TYPE BAND
&END GLOBAL

&MOTION
  &BAND
    BAND_TYPE CI-NEB
    NUMBER_OF_REPLICA 3
    K_SPRING 2.0000000000000000e-02
    EXTERNAL_PRESSURE [bar] 5.0000000000000000e+01
    ALIGN_FRAMES F
    ROTATE_FRAMES F
    SOLID_STATE
    &CI_NEB
      NSTEPS_IT 0
    &END CI_NEB
    &OPTIMIZE_BAND
      OPT_TYPE DIIS
      &DIIS
        MAX_STEPS 2000
      &END DIIS
    &END OPTIMIZE_BAND
    &PROGRAM_RUN_INFO ON
    &END PROGRAM_RUN_INFO
    &CONVERGENCE_INFO ON
      FILENAME convergence
    &END CONVERGENCE_INFO
    &REPLICA
      CELL_MATRIX [angstrom] 1.0000000000000000e+01 0.0000000000000000e+00 0.0000000000000000e+00 0.0000000000000000e+00 1.0000000000000000e+01 0.0000000000000000e+00 0.0000000000000000e+00 0.0000000000000000e+00 1.0000000000000000e+01
      &COORD
        2.0000000000000000e+00 2.0000000000000000e+00 2.0000000000000000e+00
        5.3000000000000007e+00 3.0000000000000004e+00 2.0000000000000000e+00
      &END COORD
    &END REPLICA
    &REPLICA
      CELL_MATRIX [angstrom] 1.0250000000000000e+01 0.0000000000000000e+00 0.0000000000000000e+00 4.0000000000000002e-01 9.8499999999999996e+00 0.0000000000000000e+00 -1.4999999999999999e-01 2.0000000000000001e-01 1.0100000000000000e+01
      &COORD
        2.0512722958599250e+00 2.0002496462502526e+00 2.0001960784313728e+00
        5.5078831206021928e+00 2.7973888215079845e+00 2.0001960784313728e+00
      &END COORD
    &END REPLICA
    &REPLICA
      CELL_MATRIX [angstrom] 1.0500000000000000e+01 0.0000000000000000e+00 0.0000000000000000e+00 8.0000000000000004e-01 9.6999999999999993e+00 0.0000000000000000e+00 -2.9999999999999999e-01 4.0000000000000002e-01 1.0199999999999999e+01
      &COORD
        2.1000000000000005e+00 2.0000000000000000e+00 2.0000000000000000e+00
        5.6999999999999993e+00 2.5999999999999996e+00 2.0000000000000000e+00
      &END COORD
    &END REPLICA
  &END BAND
&END MOTION

&FORCE_EVAL
  METHOD FIST
  STRESS_TENSOR ANALYTICAL
  &MM
    &FORCEFIELD
      &CHARGE
        ATOM Ar
        CHARGE 0.0
      &END CHARGE
      &NONBONDED
        &LENNARD-JONES
          ATOMS Ar Ar
          EPSILON 119.8
          RCUT 4.7999999999999998e+00
          SIGMA 3.4049999999999998e+00
        &END LENNARD-JONES
      &END NONBONDED
      &SPLINE
        EPS_SPLINE 1.0E-10
      &END SPLINE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &SUBSYS
    &CELL
      A [angstrom] 1.0000000000000000e+01 0.0000000000000000e+00 0.0000000000000000e+00
      B [angstrom] 0.0000000000000000e+00 1.0000000000000000e+01 0.0000000000000000e+00
      C [angstrom] 0.0000000000000000e+00 0.0000000000000000e+00 1.0000000000000000e+01
      PERIODIC XYZ
    &END CELL
    &COORD
      Ar 2.0000000000000000e+00 2.0000000000000000e+00 2.0000000000000000e+00
      Ar 5.3000000000000007e+00 3.0000000000000004e+00 2.0000000000000000e+00
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
