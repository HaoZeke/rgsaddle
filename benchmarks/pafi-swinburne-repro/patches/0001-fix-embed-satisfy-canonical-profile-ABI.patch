From 0fb16b3c6f9dad1ef3301f1ffa2efb4bb2d08ba0 Mon Sep 17 00:00:00 2001
From: Rohit Goswami <rgoswami@ieee.org>
Date: Tue, 17 Nov 2026 16:22:18 +0000
Subject: [PATCH] fix(embed): satisfy the canonical profile ABI

Retain C linkage for helper implementations and advertise the canonical prefixed schema identifier expected by rgpot.
---
 src/lammpc_capabilities.c        | 3 ++-
 src/lammpc_params.h              | 8 ++++++++
 tests/test_capabilities_cmocka.c | 2 +-
 3 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/lammpc_capabilities.c b/src/lammpc_capabilities.c
index 51486a4..283ff78 100644
--- a/src/lammpc_capabilities.c
+++ b/src/lammpc_capabilities.c
@@ -77,7 +77,8 @@ int lammpc_capabilities_result(void *capabilities_capnp,
   view.protocolFamily = (capn_text){sizeof("rgpot.potentials") - 1, "rgpot.potentials", NULL};
   view.protocolMajor = 1;
   view.protocolMinor = 0;
-  view.schemaId = (capn_text){16, "bd1f89fa17369103", NULL};
+  view.schemaId =
+      (capn_text){sizeof("0xbd1f89fa17369103") - 1, "0xbd1f89fa17369103", NULL};
   view.bridgeAbiMajor = 1;
   view.bridgeAbiMinor = 0;
   view.bridgeLayout = 1;
diff --git a/src/lammpc_params.h b/src/lammpc_params.h
index 3f67837..3c5edbf 100644
--- a/src/lammpc_params.h
+++ b/src/lammpc_params.h
@@ -7,6 +7,10 @@
 #define LAMMPC_BOHR_TO_ANGSTROM 0.529177210903
 #define LAMMPC_HARTREE_TO_EV 27.211386245988
 
+#ifdef __cplusplus
+extern "C" {
+#endif
+
 /** Root a flat `ForceInput` message; caller releases via
  * `lammpc_params_release()`. */
 int lammpc_force_input_root(const void *force_input_capnp,
@@ -42,3 +46,7 @@ int lammpc_potential_result_write(double energy, const double *forces,
                                   void *potential_result_capnp,
                                   size_t potential_result_capacity_bytes,
                                   size_t *potential_result_size_bytes);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/tests/test_capabilities_cmocka.c b/tests/test_capabilities_cmocka.c
index 30dd361..62a5eff 100644
--- a/tests/test_capabilities_cmocka.c
+++ b/tests/test_capabilities_cmocka.c
@@ -49,7 +49,7 @@ static void test_capabilities_round_trip(void **state) {
   assert_true(text_equals(view.protocolFamily, "rgpot.potentials"));
   assert_int_equal(view.protocolMajor, 1);
   assert_int_equal(view.protocolMinor, 0);
-  assert_true(text_equals(view.schemaId, "bd1f89fa17369103"));
+  assert_true(text_equals(view.schemaId, "0xbd1f89fa17369103"));
   assert_int_equal(view.bridgeAbiMajor, 1);
   assert_int_equal(view.bridgeAbiMinor, 0);
   assert_int_equal(view.bridgeLayout, 1);
-- 
2.43.0

